{
  "name": "yummly",
  "private": true,
  "version": "2.0.0",
  "description": "Yummly — cuisine avec ce que tu as : recettes, frigo, courses et planning de la semaine.",
  "type": "module",
  "scripts": {
    "dev": "npm run data && vite",
    "build": "npm run data && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "npm run data && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "data": "node scripts/build-catalog.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@preact/signals": "2.11.4",
    "@supabase/supabase-js": "2.118.0",
    "@zxing/browser": "0.2.1",
    "@zxing/library": "0.23.0",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.6",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "3.2.7",
    "workbox-window": "7.4.1"
  }
}
